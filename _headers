# Global security headers (safe for ads — no COEP here).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Always revalidate JS/CSS so a deploy is never masked by a stale cache.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

# Cross-origin isolation for in-browser video processing (scoped — no ad pages).

/tools/video/compress-for-discord/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/tools/video/trim-video/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/tools/video/video-to-gif/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/tools/video/vertical-reframe/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/tools/video/mute-video/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/tools/video/extract-audio/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/tools/video/frame-grabber/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

