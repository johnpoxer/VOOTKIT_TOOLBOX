# ---------------------------------------------------------------------------
# Generated build output — produced by `npm run build` (build.js) and
# regenerated by Netlify on every deploy. Keeping it OUT of Git means adding a
# language or editing a template no longer churns ~600 HTML files, so GitHub
# Desktop stops choking and pushes stay small. Netlify rebuilds all of this.
# Only SOURCE lives in the repo: build.js, data/, assets/, netlify/, content/,
# admin/, docs/, supabase/, i18n-source/, and the hand-authored index.html.
# ---------------------------------------------------------------------------

# Generated top-level pages
/pricing.html
/about.html
/contact.html
/privacy.html
/terms.html
/cookies.html
/disclaimer.html

# Generated route directories
/tools/
/templates/
/auth/
/account/
/components/
/blog/
/admin-console/
/contact-success/
/unsubscribe/

# Generated localized directories (one per language)
/es/
/pt/
/fr/
/de/
/hi/
/id/
/it/
/zh/
/ar/
/ja/

# Generated deploy artifacts
/sitemap.xml
/robots.txt
/_redirects
/_headers
/assets/css/app.css
