# Vootkit is generated with LF line endings (the Node build runs on Linux).
# Force LF in the repo and on checkout so Windows / GitHub Desktop stop warning
# about "LF will be replaced by CRLF" and stop showing unchanged files as modified.
* text=auto eol=lf

# Binary assets — never normalise line endings on these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.svg  text eol=lf
*.woff  binary
*.woff2 binary
*.ttf  binary
*.pdf  binary
*.zip  binary
*.mp4  binary
